generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  ADMIN
  MANAGER
  STAFF
  VIEWER
}

enum PaymentMethod {
  CASH
  CARD
  BANK_TRANSFER
  MOBILE_MONEY
  CHEQUE
  OTHER
}

enum ExpenseStatus {
  DRAFT
  PENDING
  APPROVED
  REJECTED
  PAID
}

model Department {
  id          String    @id @default(cuid())
  name        String    @unique
  code        String    @unique
  description String?
  budget      Float?
  color       String?
  icon        String?
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  createdBy   String?
  updatedBy   String?

  // Relationships
  expenses    Expense[]
  users       User[]    // Add this reverse relation
  createdByUser User?    @relation("DepartmentCreatedBy", fields: [createdBy], references: [id])
  updatedByUser User?    @relation("DepartmentUpdatedBy", fields: [updatedBy], references: [id])

  @@index([isActive])
  @@index([code])
}

model User {
  id            String    @id @default(cuid())
  firstName     String
  lastName      String
  email         String    @unique
  password      String
  role          UserRole  @default(STAFF)
  departmentId  String?
  lastLoginDate DateTime?
  imageUrl      String?
  isVerified    Boolean   @default(false)
  isLocked      Boolean   @default(false)
  isActive      Boolean   @default(true)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  createdBy     String?
  updatedBy     String?
  deletedBy     String?
  deletedAt     DateTime?

  // Self-referential relationships for audit trail
  createdByUser User?      @relation("UserCreatedBy", fields: [createdBy], references: [id])
  updatedByUser User?      @relation("UserUpdatedBy", fields: [updatedBy], references: [id])
  deletedByUser User?      @relation("UserDeletedBy", fields: [deletedBy], references: [id])
  
  // Users created/updated by this user
  createdUsers  User[]     @relation("UserCreatedBy")
  updatedUsers  User[]     @relation("UserUpdatedBy")
  deletedUsers  User[]     @relation("UserDeletedBy")

  // Relationships
  department    Department? @relation(fields: [departmentId], references: [id])
  createdExpenses Expense[] @relation("ExpenseCreatedBy")
  updatedExpenses Expense[] @relation("ExpenseUpdatedBy")
  createdCategories Category[] @relation("CategoryCreatedBy")
  updatedCategories Category[] @relation("CategoryUpdatedBy")
  createdDepartments Department[] @relation("DepartmentCreatedBy")
  updatedDepartments Department[] @relation("DepartmentUpdatedBy")

  @@index([email])
  @@index([createdAt])
  @@index([role])
  @@index([departmentId])
}

model Category {
  id          String    @id @default(cuid())
  name        String    @unique
  description String?
  color       String?
  icon        String?
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  createdBy   String?
  updatedBy   String?

  // Relationships
  expenses    Expense[]
  createdByUser User?    @relation("CategoryCreatedBy", fields: [createdBy], references: [id])
  updatedByUser User?    @relation("CategoryUpdatedBy", fields: [updatedBy], references: [id])

  @@index([isActive])
}

model Expense {
  id            String        @id @default(cuid())
  amount        Float         
  description   String
  date          DateTime
  categoryId    String
  departmentId  String?
  paymentMethod PaymentMethod @default(CARD)
  status        ExpenseStatus @default(PENDING)
  attachmentUrl String?
  notes         String?
  
  // Audit fields
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  createdBy     String
  updatedBy     String?
  
  // Relationships
  category      Category      @relation(fields: [categoryId], references: [id])
  department    Department?   @relation(fields: [departmentId], references: [id])
  createdByUser User          @relation("ExpenseCreatedBy", fields: [createdBy], references: [id])
  updatedByUser User?         @relation("ExpenseUpdatedBy", fields: [updatedBy], references: [id])

  @@index([date])
  @@index([status])
  @@index([categoryId])
  @@index([departmentId])
  @@index([createdBy])
}